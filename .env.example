# Copy this file to .env and fill in ONE provider key.

# Provider A — OpenAI image editing. Takes precedence when both keys are set.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Provider B — FASHN, a purpose-built try-on model. Key from https://app.fashn.ai/api
FASHN_API_KEY=

# Required before exposing this to the internet — anyone who can load the page
# spends your credits. Any non-empty value; the browser asks for it via basic auth
# (leave the username blank).
ACCESS_PASSWORD=

# Optional
PORT=3000
HOST=              # set to 127.0.0.1 when a reverse proxy sits in front
RATE_LIMIT=20        # generations allowed per IP per window
RATE_WINDOW_MIN=10   # window length, in minutes
TRUST_PROXY=0        # set to 1 only when behind a proxy that sets X-Forwarded-For
